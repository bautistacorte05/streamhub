{
  "name": "streamhub",
  "private": true,
  "version": "0.1.3",
  "description": "Carpeta unica para todas tus apps de streaming + buscador de en que plataforma esta cada titulo",
  "author": "bauti",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "prepare:electron": "node scripts/copy-electron-pkg.mjs",
    "dev": "npm run prepare:electron && concurrently -k -n VITE,TSC,ELECTRON \"vite\" \"tsc -p tsconfig.electron.json --watch --preserveWatchOutput\" \"wait-on tcp:5174 dist-electron/main.js && cross-env VITE_DEV_SERVER_URL=http://localhost:5174 electron .\"",
    "build": "tsc -b && npm run prepare:electron && vite build",
    "dist": "npm run build && electron-builder",
    "release": "npm run build && electron-builder --publish always",
    "start": "electron .",
    "preview:fresh": "npm run build && node scripts/preview-fresh.mjs",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.79.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.bauti.streamhub",
    "productName": "StreamHub",
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "directories": {
      "output": "release"
    },
    "publish": {
      "provider": "github",
      "owner": "bautistacorte05",
      "repo": "streamhub",
      "draft": false
    }
  }
}
